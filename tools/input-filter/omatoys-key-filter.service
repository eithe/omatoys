[Unit]
Description=Omatoys Key Filter
Documentation=https://github.com/eithe/omatoys

[Service]
Type=simple
# Override the 10 ms default debounce window with:
#   systemctl edit omatoys-key-filter.service
#   [Service]
#   Environment=OMATOYS_FILTER_WINDOW_MS=20
ExecStart=/usr/local/libexec/omatoys-input-filter key
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
