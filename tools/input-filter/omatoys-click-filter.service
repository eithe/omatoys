[Unit]
Description=Omatoys Click Filter
Documentation=https://github.com/eithe/omatoys

[Service]
Type=simple
# Override the 25 ms default debounce window with:
#   systemctl edit omatoys-click-filter.service
#   [Service]
#   Environment=OMATOYS_FILTER_WINDOW_MS=40
ExecStart=/usr/local/libexec/omatoys-input-filter click
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
